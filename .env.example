# Salin file ini menjadi .env lalu isi seperlunya. Semua opsional.

# API WhatsApp: wwebjs atau baileys (bisa juga lewat --api atau app/settings/data.json)
WA_API=
# Login Baileys dengan kode pairing (nomor bot, format 628xxx)
PAIRING_NUMBER=
# Log Baileys: silent | info | debug
BAILEYS_LOG=

# Lokasi program (kosongkan bila sudah ada di PATH)
CHROME_PATH=
FFMPEG_PATH=
YTDLP_PATH=

# API key layanan pihak ketiga (dipakai lewat global.API di config.js)
APIKEY_LOLHUMAN=
